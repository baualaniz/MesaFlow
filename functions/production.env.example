# Copiar como .env.mesaflow-produccion solo después de configurar los proveedores.
# Este archivo contiene parámetros backend no secretos. Nunca agregues tokens aquí.
MERCADO_PAGO_ENVIRONMENT=production
WHATSAPP_PHONE_NUMBER_ID=REEMPLAZAR_ID_NUMERO
WHATSAPP_GRAPH_API_VERSION=REEMPLAZAR_VERSION_VIGENTE
WHATSAPP_TEMPLATE_NAME=REEMPLAZAR_PLANTILLA_APROBADA
WHATSAPP_TEMPLATE_LANGUAGE=REEMPLAZAR_IDIOMA_APROBADO
CUSTOMER_PUBLIC_BASE_URL=https://mesaflow-produccion.web.app
