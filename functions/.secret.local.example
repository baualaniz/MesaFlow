# Copy this file to .secret.local only when the matching integrations are built.
# Never commit .secret.local and never use production credentials in the emulator.
# For Stage 28, replace only MERCADO_PAGO_ACCESS_TOKEN with the test credential
# copied from Tests > Test credentials. It starts with APP_USR but must never be
# pasted into chat, screenshots, source code or command history.
MERCADO_PAGO_ACCESS_TOKEN=REEMPLAZAR_SOLO_LOCAL_MP_ACCESS_TOKEN
MERCADO_PAGO_WEBHOOK_SECRET=REEMPLAZAR_SOLO_LOCAL_MP_WEBHOOK_SECRET
WHATSAPP_ACCESS_TOKEN=REEMPLAZAR_SOLO_LOCAL_WHATSAPP_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=REEMPLAZAR_SOLO_LOCAL_WHATSAPP_VERIFY_TOKEN
