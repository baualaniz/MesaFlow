{
  "version": 1,
  "localProjectId": "demo-mesaflow",
  "targets": [
    {
      "name": "customer",
      "kind": "spa",
      "public": "apps/customer/build/web",
      "build": "flutter-web"
    },
    {
      "name": "admin",
      "kind": "spa",
      "public": "apps/admin/hosting",
      "build": "react-typescript-vite"
    },
    {
      "name": "landing",
      "kind": "static",
      "public": "apps/landing/hosting",
      "build": "astro-static"
    }
  ],
  "emulator": {
    "host": "127.0.0.1",
    "basePort": 5100
  },
  "plannedCloudSites": {
    "dev": {
      "customer": "mesaflow-desarrollo",
      "admin": "mesaflow-desarrollo-admin",
      "landing": "mesaflow-desarrollo-landing"
    },
    "prod": {
      "customer": "mesaflow-produccion",
      "admin": "mesaflow-produccion-admin",
      "landing": "mesaflow-produccion-landing"
    }
  },
  "cloudStatus": "deferred"
}
