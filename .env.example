# Public Firebase web configuration. These values identify a Firebase app but
# are not privileged secrets. Copy only the values for the intended environment.
FIREBASE_API_KEY=TU_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=TU_PROYECTO.firebaseapp.com
FIREBASE_PROJECT_ID=TU_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=TU_PROYECTO.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=TU_MESSAGING_SENDER_ID
FIREBASE_APP_ID=TU_FIREBASE_APP_ID

# Public application URLs
PUBLIC_CUSTOMER_URL=http://localhost:5000
PUBLIC_ADMIN_URL=http://localhost:5001
PUBLIC_LANDING_URL=http://localhost:5002

# The following values are documentation placeholders only. Production secrets
# must be stored with Firebase/Google Cloud Secret Manager, never in this file.
MERCADO_PAGO_ACCESS_TOKEN=TU_MERCADO_PAGO_ACCESS_TOKEN
MERCADO_PAGO_WEBHOOK_SECRET=TU_MERCADO_PAGO_WEBHOOK_SECRET
WHATSAPP_ACCESS_TOKEN=TU_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=TU_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=GENERA_UN_TOKEN_ALEATORIO_LARGO

