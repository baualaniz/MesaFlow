# Public frontend configuration. These values identify Firebase applications but
# are not privileged credentials. Authorization never depends on hiding them.
PUBLIC_FIREBASE_API_KEY=REEMPLAZAR_FIREBASE_WEB_API_KEY
PUBLIC_FIREBASE_AUTH_DOMAIN=REEMPLAZAR_PROYECTO.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=REEMPLAZAR_FIREBASE_PROJECT_ID
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REEMPLAZAR_MESSAGING_SENDER_ID
PUBLIC_FIREBASE_APP_ID=REEMPLAZAR_FIREBASE_APP_ID

# Public application URLs
PUBLIC_CUSTOMER_URL=http://localhost:5000
PUBLIC_ADMIN_URL=http://localhost:5001
PUBLIC_LANDING_URL=http://localhost:5002
