{
  "name": "mesaflow",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo del MVP SaaS multiestablecimiento MesaFlow",
  "homepage": "https://github.com/baualaniz/MesaFlow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baualaniz/MesaFlow.git"
  },
  "bugs": {
    "url": "https://github.com/baualaniz/MesaFlow/issues"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "workspaces": [
    "apps/admin",
    "apps/landing",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check:repo && npm run test:config && npm run test:tooling && npm run test:auth-config && npm run test:firestore-config && npm run test:firestore-indexes && npm run test:storage-config && npm run test:secrets-config && npm run test:mercado-pago-config && npm run test:hosting-config && npm run test:presentation-seed && npm run test:demo-seed && npm run test:customer-config && npm run test:contracts && npm run admin:check && npm run functions:check",
    "check:repo": "node ./scripts/check-repository.mjs",
    "test:config": "node --test ./scripts/firebase-projects.test.mjs ./scripts/emulator-config.test.mjs",
    "test:tooling": "node --test ./scripts/tooling-dependencies.test.mjs ./scripts/java-runtime.test.mjs",
    "test:auth-config": "node --test ./scripts/auth-config.test.mjs",
    "test:firestore-config": "node --test ./scripts/firestore-config.test.mjs",
    "test:firestore-indexes": "node --test ./scripts/firestore-indexes.test.mjs",
    "test:storage-config": "node --test ./scripts/storage-config.test.mjs",
    "test:secrets-config": "node --test ./scripts/secrets-config.test.mjs",
    "test:mercado-pago-config": "node --test ./scripts/mercado-pago-config.test.mjs",
    "test:hosting-config": "node --test ./scripts/hosting-config.test.mjs",
    "test:presentation-seed": "node --test ./scripts/presentation-seed.test.mjs",
    "test:demo-seed": "node --test ./scripts/demo-seed.test.mjs",
    "test:customer-config": "node --test ./scripts/customer-firebase-config.test.mjs",
    "test:contracts": "npm run check --workspace @mesaflow/contracts",
    "test:contracts:flutter": "node ./scripts/test-customer-contracts.mjs",
    "contracts:check": "npm run test:contracts && npm run test:contracts:flutter",
    "auth:check": "node ./scripts/check-auth-config.mjs",
    "firestore:check": "node ./scripts/check-firestore-config.mjs",
    "firestore:indexes:check:dev": "node ./scripts/check-firestore-indexes.mjs dev",
    "firestore:queries:check:dev": "node ./scripts/check-firestore-queries.mjs dev",
    "firestore:smoke:dev": "node ./scripts/firestore-cloud-smoke.mjs dev",
    "firebase:seed:presentation:dev": "node ./scripts/seed-presentation-dev.mjs",
    "firebase:seed:demo": "node ./scripts/seed-demo-emulator.mjs",
    "storage:check": "node ./scripts/check-storage-config.mjs",
    "secrets:check": "node ./scripts/check-secrets-config.mjs",
    "mercado-pago:check": "node ./scripts/check-mercado-pago-config.mjs",
    "hosting:check": "node ./scripts/check-hosting-config.mjs",
    "hosting:build": "node ./scripts/build-hosting.mjs",
    "functions:build": "npm run build --workspace @mesaflow/functions",
    "functions:lint": "npm run lint --workspace @mesaflow/functions",
    "functions:test": "npm test --workspace @mesaflow/functions",
    "functions:check": "npm run check --workspace @mesaflow/functions",
    "admin:check": "npm run check --workspace @mesaflow/admin",
    "preview:customer": "node ./scripts/serve-customer-preview.mjs",
    "check:env": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-environment.ps1",
    "emulators": "node ./scripts/run-emulators.mjs start",
    "test:emulators": "node ./scripts/run-emulators.mjs test",
    "test:emulator:clients": "node ./scripts/functions-emulator-smoke.mjs && node ./scripts/hosting-emulator-smoke.mjs && node ./scripts/emulator-smoke.mjs && node ./scripts/firestore-repository-emulator.mjs && node ./scripts/firestore-query-emulator.mjs && node ./scripts/seed-demo-emulator.mjs && node ./scripts/admin-auth-emulator-smoke.mjs && node ./scripts/admin-tenant-emulator-smoke.mjs && node ./scripts/admin-orders-emulator-smoke.mjs && node ./scripts/admin-assistance-emulator-smoke.mjs && node ./scripts/admin-metrics-emulator-smoke.mjs && node ./scripts/admin-tables-emulator-smoke.mjs && node ./scripts/admin-catalog-emulator-smoke.mjs && node ./scripts/admin-team-emulator-smoke.mjs && node ./scripts/qr-session-emulator.mjs && node --test ./firebase/tests/firestore.rules.test.mjs && node --test ./firebase/tests/storage.rules.test.mjs",
    "firebase:login": "firebase login",
    "firebase:projects": "firebase projects:list",
    "firebase:use:dev": "firebase use dev"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "basic-ftp": "6.2.2",
    "braces": "3.0.3",
    "firebase-tools": {
      "qs": "6.16.0",
      "gaxios@6.7.1": {
        "uuid": "11.1.1"
      },
      "@google-cloud/pubsub": {
        "@opentelemetry/core": "2.8.0"
      },
      "csv-parse": "7.0.2"
    }
  }
}
