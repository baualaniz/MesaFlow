rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipPath(establishmentId) {
      return /databases/$(database)/documents/establishments/$(establishmentId)/members/$(request.auth.uid);
    }

    function isActiveMember(establishmentId) {
      return signedIn()
        && exists(membershipPath(establishmentId))
        && get(membershipPath(establishmentId)).data.active == true
        && get(membershipPath(establishmentId)).data.establishmentId == establishmentId
        && get(membershipPath(establishmentId)).data.uid == request.auth.uid;
    }

    function hasRole(establishmentId, roles) {
      return isActiveMember(establishmentId)
        && get(membershipPath(establishmentId)).data.role in roles;
    }

    function academicDeploymentPath(establishmentId) {
      return /databases/$(database)/documents/academicDeployments/$(establishmentId);
    }

    function isAcademicDemo(establishmentId) {
      return exists(academicDeploymentPath(establishmentId))
        && get(academicDeploymentPath(establishmentId)).data.active == true
        && get(academicDeploymentPath(establishmentId)).data.establishmentId == establishmentId;
    }

    function academicQrPath(establishmentId, qrHash) {
      return /databases/$(database)/documents/establishments/$(establishmentId)/qrAccess/$(qrHash);
    }

    function tablePath(establishmentId, tableId) {
      return /databases/$(database)/documents/establishments/$(establishmentId)/tables/$(tableId);
    }

    function tableSessionPath(establishmentId, sessionId) {
      return /databases/$(database)/documents/establishments/$(establishmentId)/tableSessions/$(sessionId);
    }

    function participantPath(establishmentId, sessionId) {
      return /databases/$(database)/documents/establishments/$(establishmentId)/tableSessions/$(sessionId)/participants/$(request.auth.uid);
    }

    function isActiveParticipant(establishmentId, sessionId) {
      return signedIn()
        && exists(participantPath(establishmentId, sessionId))
        && get(participantPath(establishmentId, sessionId)).data.active == true
        && get(participantPath(establishmentId, sessionId)).data.establishmentId == establishmentId
        && get(participantPath(establishmentId, sessionId)).data.sessionId == sessionId
        && get(participantPath(establishmentId, sessionId)).data.uid == request.auth.uid
        && (!isAcademicDemo(establishmentId)
          || validAcademicParticipant(establishmentId, sessionId));
    }

    function validAcademicParticipant(establishmentId, sessionId) {
      let participant = get(participantPath(establishmentId, sessionId)).data;
      let qr = get(academicQrPath(establishmentId, participant.qrHash)).data;
      let table = get(tablePath(establishmentId, participant.tableId)).data;
      let session = get(tableSessionPath(establishmentId, sessionId)).data;
      return participant.qrHash is string
        && participant.qrHash.matches('^[a-f0-9]{64}$')
        && participant.qrVersion is int
        && qr.active == true
        && qr.establishmentId == establishmentId
        && qr.tableId == participant.tableId
        && qr.qrVersion == participant.qrVersion
        && qr.sessionId == sessionId
        && table.active == true
        && table.qrTokenHash == participant.qrHash
        && table.qrVersion == participant.qrVersion
        && table.currentSessionId == sessionId
        && session.status == 'open'
        && session.tableId == participant.tableId;
    }

    function validAcademicParticipantCreate(establishmentId, sessionId, uid, data) {
      let qr = get(academicQrPath(establishmentId, data.qrHash)).data;
      let table = get(tablePath(establishmentId, data.tableId)).data;
      let session = get(tableSessionPath(establishmentId, sessionId)).data;
      return isAcademicDemo(establishmentId)
        && signedIn() && request.auth.uid == uid
        && data.keys().hasOnly([
          'active', 'establishmentId', 'joinedAt', 'qrHash', 'qrVersion',
          'revokedAt', 'sessionId', 'tableId', 'uid'
        ])
        && data.keys().hasAll([
          'active', 'establishmentId', 'joinedAt', 'qrHash', 'qrVersion',
          'revokedAt', 'sessionId', 'tableId', 'uid'
        ])
        && data.active == true && data.establishmentId == establishmentId
        && data.sessionId == sessionId && data.uid == uid
        && data.joinedAt == request.time && data.revokedAt == null
        && data.qrHash is string && data.qrHash.matches('^[a-f0-9]{64}$')
        && data.qrVersion is int && data.qrVersion >= 1
        && qr.active == true && qr.establishmentId == establishmentId
        && qr.tableId == data.tableId && qr.qrVersion == data.qrVersion
        && qr.sessionId == sessionId
        && table.active == true && table.qrTokenHash == data.qrHash
        && table.qrVersion == data.qrVersion
        && table.currentSessionId == sessionId
        && session.status == 'open' && session.tableId == data.tableId;
    }

    function validCategory(establishmentId, data) {
      return data.keys().hasOnly([
          'establishmentId', 'name', 'description', 'sortOrder', 'active',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'establishmentId', 'name', 'description', 'sortOrder', 'active',
          'createdAt', 'updatedAt'
        ])
        && data.establishmentId == establishmentId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 500
        && data.sortOrder is int && data.sortOrder >= 0
        && data.active is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validProduct(establishmentId, data) {
      return data.keys().hasOnly([
          'establishmentId', 'categoryId', 'name', 'description', 'priceMinor',
          'currency', 'imagePath', 'available', 'active', 'sortOrder',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'establishmentId', 'categoryId', 'name', 'description', 'priceMinor',
          'currency', 'imagePath', 'available', 'active', 'sortOrder',
          'createdAt', 'updatedAt'
        ])
        && data.establishmentId == establishmentId
        && data.categoryId is string && data.categoryId.size() > 0
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 500
        && data.priceMinor is int && data.priceMinor >= 0
        && data.priceMinor <= 9000000000000
        && data.currency is string && data.currency.matches('^[A-Z]{3}$')
        && (data.imagePath == null || data.imagePath is string)
        && data.available is bool && data.active is bool
        && data.sortOrder is int && data.sortOrder >= 0
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validBusinessDay(data) {
      return data is map
        && data.keys().hasOnly(['closed', 'open', 'close'])
        && data.keys().hasAll(['closed', 'open', 'close'])
        && data.closed is bool
        && data.open is string
        && data.open.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.close is string
        && data.close.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (data.closed == true || data.open != data.close);
    }

    function validBusinessHours(data) {
      return data is map
        && data.keys().hasOnly([
          'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'
        ])
        && data.keys().hasAll([
          'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'
        ])
        && validBusinessDay(data.monday)
        && validBusinessDay(data.tuesday)
        && validBusinessDay(data.wednesday)
        && validBusinessDay(data.thursday)
        && validBusinessDay(data.friday)
        && validBusinessDay(data.saturday)
        && validBusinessDay(data.sunday);
    }

    function validPublicSettings(establishmentId, data) {
      return data.keys().hasOnly([
          'establishmentId', 'brandName', 'contactEmail', 'contactPhone', 'addressLine',
          'businessHours', 'orderingEnabled', 'assistanceEnabled', 'updatedAt'
        ])
        && data.keys().hasAll([
          'establishmentId', 'brandName', 'contactEmail', 'contactPhone', 'addressLine',
          'businessHours', 'orderingEnabled', 'assistanceEnabled', 'updatedAt'
        ])
        && data.establishmentId == establishmentId
        && data.brandName is string && data.brandName.size() >= 2 && data.brandName.size() <= 120
        && data.contactEmail is string && data.contactEmail.size() >= 3
        && data.contactEmail.size() <= 254 && data.contactEmail.matches('^.+@.+[.].+$')
        && data.contactPhone is string && data.contactPhone.size() <= 30
        && data.addressLine is string && data.addressLine.size() <= 200
        && validBusinessHours(data.businessHours)
        && data.orderingEnabled is bool && data.assistanceEnabled is bool
        && data.updatedAt == request.time;
    }

    function validPrivateSettings(establishmentId, data) {
      return data.keys().hasOnly([
          'establishmentId', 'mercadoPagoEnabled', 'whatsappEnabled',
          'whatsappOptInConfirmed', 'whatsappRecipient', 'updatedAt'
        ])
        && data.keys().hasAll([
          'establishmentId', 'mercadoPagoEnabled', 'whatsappEnabled',
          'whatsappOptInConfirmed', 'whatsappRecipient', 'updatedAt'
        ])
        && data.establishmentId == establishmentId
        && data.mercadoPagoEnabled is bool && data.whatsappEnabled is bool
        && data.whatsappOptInConfirmed is bool
        && data.whatsappRecipient is string && data.whatsappRecipient.size() <= 15
        && (data.whatsappRecipient == ''
          || data.whatsappRecipient.matches('^[0-9]{8,15}$'))
        && (data.whatsappEnabled == false
          || (data.whatsappOptInConfirmed == true && data.whatsappRecipient != ''))
        && data.updatedAt == request.time;
    }

    function validAcademicUserProfile(establishmentId, data) {
      return data.keys().hasOnly([
          'createdAt', 'displayName', 'email', 'establishmentIds', 'updatedAt'
        ])
        && data.keys().hasAll([
          'createdAt', 'displayName', 'email', 'establishmentIds', 'updatedAt'
        ])
        && data.displayName is string && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.establishmentIds is list && data.establishmentIds.size() == 1
        && data.establishmentIds[0] == establishmentId
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validAcademicMembership(establishmentId, uid, data) {
      return data.keys().hasOnly([
          'active', 'createdAt', 'establishmentId', 'permissions', 'role', 'uid',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'active', 'createdAt', 'establishmentId', 'permissions', 'role', 'uid',
          'updatedAt'
        ])
        && data.active is bool && data.establishmentId == establishmentId
        && data.uid == uid && data.role in ['owner', 'manager', 'staff', 'kitchen']
        && data.permissions is list && data.permissions.size() <= 6
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validAcademicTeamProfile(establishmentId, uid, data) {
      return data.keys().hasOnly([
          'createdAt', 'displayName', 'email', 'establishmentId', 'uid', 'updatedAt'
        ])
        && data.keys().hasAll([
          'createdAt', 'displayName', 'email', 'establishmentId', 'uid', 'updatedAt'
        ])
        && data.establishmentId == establishmentId && data.uid == uid
        && data.displayName is string && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function canManageAcademicTeam(establishmentId, targetRole) {
      return isAcademicDemo(establishmentId)
        && hasRole(establishmentId, ['owner', 'manager'])
        && (get(membershipPath(establishmentId)).data.role == 'owner'
          || targetRole in ['staff', 'kitchen']);
    }

    function canUpdateAcademicTeam(establishmentId, currentRole, targetRole) {
      return canManageAcademicTeam(establishmentId, targetRole)
        && (get(membershipPath(establishmentId)).data.role == 'owner'
          || currentRole in ['staff', 'kitchen']);
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.resource.data.establishmentIds is list
        && request.resource.data.establishmentIds.size() == 1
        && canManageAcademicTeam(request.resource.data.establishmentIds[0], 'staff')
        && validAcademicUserProfile(
          request.resource.data.establishmentIds[0], request.resource.data
        );
      allow list, update, delete: if false;
    }

    match /academicDeployments/{establishmentId} {
      allow read, write: if false;
    }

    match /establishmentSlugs/{slug} {
      allow get: if resource.data.active == true;
      allow list, write: if false;
    }

    match /establishments/{establishmentId} {
      allow get: if resource.data.active == true || isActiveMember(establishmentId);
      allow list, write: if false;

      match /members/{uid} {
        allow get: if signedIn()
          && ((request.auth.uid == uid
              && resource.data.establishmentId == establishmentId)
            || hasRole(establishmentId, ['owner', 'manager']));
        allow list: if hasRole(establishmentId, ['owner', 'manager']);
        allow create: if canManageAcademicTeam(establishmentId, request.resource.data.role)
          && validAcademicMembership(establishmentId, uid, request.resource.data);
        allow update: if canUpdateAcademicTeam(
            establishmentId, resource.data.role, request.resource.data.role
          )
          && validAcademicMembership(establishmentId, uid, request.resource.data)
          && request.resource.data.establishmentId == resource.data.establishmentId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /teamProfiles/{uid} {
        allow read: if hasRole(establishmentId, ['owner', 'manager']);
        allow create: if canManageAcademicTeam(establishmentId, 'staff')
          && validAcademicTeamProfile(establishmentId, uid, request.resource.data);
        allow update: if canManageAcademicTeam(establishmentId, 'staff')
          && validAcademicTeamProfile(establishmentId, uid, request.resource.data)
          && request.resource.data.establishmentId == resource.data.establishmentId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow get: if isActiveMember(establishmentId)
          || (resource.data.establishmentId == establishmentId
            && resource.data.active == true);
        allow list: if resource.data.active == true || isActiveMember(establishmentId);
        allow create: if hasRole(establishmentId, ['owner', 'manager'])
          && validCategory(establishmentId, request.resource.data);
        allow update: if hasRole(establishmentId, ['owner', 'manager'])
          && validCategory(establishmentId, request.resource.data)
          && resource.data.establishmentId == establishmentId
          && request.resource.data.establishmentId == resource.data.establishmentId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if hasRole(establishmentId, ['owner', 'manager'])
          && resource.data.establishmentId == establishmentId;
      }

      match /products/{productId} {
        allow get: if resource.data.establishmentId == establishmentId
          && ((resource.data.active == true && resource.data.available == true)
            || isActiveMember(establishmentId));
        allow list: if (resource.data.active == true && resource.data.available == true)
          || isActiveMember(establishmentId);
        allow create: if hasRole(establishmentId, ['owner', 'manager'])
          && validProduct(establishmentId, request.resource.data);
        allow update: if validProduct(establishmentId, request.resource.data)
          && resource.data.establishmentId == establishmentId
          && request.resource.data.establishmentId == resource.data.establishmentId
          && request.resource.data.createdAt == resource.data.createdAt
          && (hasRole(establishmentId, ['owner', 'manager'])
            || (hasRole(establishmentId, ['staff'])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['available', 'updatedAt'])));
        allow delete: if hasRole(establishmentId, ['owner', 'manager'])
          && resource.data.establishmentId == establishmentId;
      }

      match /tables/{tableId} {
        allow get: if isActiveMember(establishmentId);
        allow list: if isActiveMember(establishmentId);
        allow write: if isAcademicDemo(establishmentId)
          && hasRole(establishmentId, ['owner', 'manager']);
      }

      match /qrAccess/{qrHash} {
        allow get: if resource.data.establishmentId == establishmentId
          && (isActiveMember(establishmentId)
            || (signedIn() && resource.data.active == true
              && qrHash.matches('^[a-f0-9]{64}$')));
        allow list: if isActiveMember(establishmentId);
        allow write: if isAcademicDemo(establishmentId)
          && hasRole(establishmentId, ['owner', 'manager']);
      }

      match /tableSessions/{sessionId} {
        allow get: if resource.data.establishmentId == establishmentId
          && (isActiveMember(establishmentId)
            || isActiveParticipant(establishmentId, sessionId));
        allow list: if isActiveMember(establishmentId);
        allow create, delete: if isAcademicDemo(establishmentId)
          && hasRole(establishmentId, ['owner', 'manager']);
        allow update: if (isAcademicDemo(establishmentId)
            && hasRole(establishmentId, ['owner', 'manager']))
          || (isAcademicDemo(establishmentId)
            && hasRole(establishmentId, ['owner', 'manager', 'staff'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['paidMinor', 'balanceMinor', 'status', 'updatedAt'])
            && request.resource.data.paidMinor >= resource.data.paidMinor
            && request.resource.data.balanceMinor <= resource.data.balanceMinor
            && request.resource.data.paidMinor - resource.data.paidMinor
              == resource.data.balanceMinor - request.resource.data.balanceMinor
            && request.resource.data.paidMinor + request.resource.data.balanceMinor
              == resource.data.subtotalMinor
            && request.resource.data.balanceMinor >= 0
            && ((request.resource.data.balanceMinor == 0
                && request.resource.data.status == 'paid')
              || (request.resource.data.balanceMinor > 0
                && request.resource.data.status == 'open')))
          || (isAcademicDemo(establishmentId)
            && isActiveParticipant(establishmentId, sessionId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['subtotalMinor', 'balanceMinor', 'updatedAt'])
            && request.resource.data.subtotalMinor >= resource.data.subtotalMinor
            && request.resource.data.balanceMinor >= resource.data.balanceMinor
            && request.resource.data.subtotalMinor - resource.data.subtotalMinor
              == request.resource.data.balanceMinor - resource.data.balanceMinor);

        match /participants/{uid} {
          allow read: if resource.data.establishmentId == establishmentId
            && resource.data.sessionId == sessionId
            && (isActiveMember(establishmentId)
              || (signedIn() && request.auth.uid == uid
                && isActiveParticipant(establishmentId, sessionId)));
          allow create: if validAcademicParticipantCreate(
            establishmentId, sessionId, uid, request.resource.data
          );
          allow update, delete: if false;
        }
      }

      match /orders/{orderId} {
        allow get: if resource.data.establishmentId == establishmentId
          && (isActiveMember(establishmentId)
            || isActiveParticipant(establishmentId, resource.data.sessionId));
        allow list: if isActiveMember(establishmentId)
          || isActiveParticipant(establishmentId, resource.data.sessionId);
        allow create: if isAcademicDemo(establishmentId)
          && isActiveParticipant(establishmentId, request.resource.data.sessionId)
          && request.resource.data.establishmentId == establishmentId
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.tableId
            == get(participantPath(establishmentId, request.resource.data.sessionId)).data.tableId
          && request.resource.data.status == 'created'
          && request.resource.data.createdAt == request.resource.data.updatedAt;
        allow update: if isAcademicDemo(establishmentId)
          && hasRole(establishmentId, ['owner', 'manager', 'staff', 'kitchen'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'statusTimestamps', 'updatedAt']);
        allow delete: if false;
      }

      match /assistanceRequests/{requestId} {
        allow get: if resource.data.establishmentId == establishmentId
          && (isActiveMember(establishmentId)
            || isActiveParticipant(establishmentId, resource.data.sessionId));
        allow list: if isActiveMember(establishmentId)
          || isActiveParticipant(establishmentId, resource.data.sessionId);
        allow create: if isAcademicDemo(establishmentId)
          && requestId == request.resource.data.sessionId
          && isActiveParticipant(establishmentId, request.resource.data.sessionId)
          && request.resource.data.establishmentId == establishmentId
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isAcademicDemo(establishmentId)
          && ((request.auth.uid == resource.data.customerUid
              && isActiveParticipant(establishmentId, resource.data.sessionId)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
              && request.resource.data.status == 'cancelled')
            || (request.auth.uid == resource.data.customerUid
              && requestId == request.resource.data.sessionId
              && resource.data.status in ['cancelled', 'resolved']
              && request.resource.data.establishmentId == establishmentId
              && request.resource.data.customerUid == request.auth.uid
              && request.resource.data.status == 'pending'
              && isActiveParticipant(
                establishmentId, request.resource.data.sessionId
              ))
            || hasRole(establishmentId, ['owner', 'manager', 'staff']));
        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow get: if resource.data.establishmentId == establishmentId
          && (hasRole(establishmentId, ['owner', 'manager'])
            || isActiveParticipant(establishmentId, resource.data.sessionId));
        allow list: if hasRole(establishmentId, ['owner', 'manager'])
          || isActiveParticipant(establishmentId, resource.data.sessionId);
        allow write: if false;
      }

      match /paymentPreferences/{intentId} {
        allow read, write: if false;
      }

      match /dailyMetrics/{date} {
        allow get: if resource.data.establishmentId == establishmentId
          && hasRole(establishmentId, ['owner', 'manager']);
        allow list: if hasRole(establishmentId, ['owner', 'manager']);
        allow write: if false;
      }

      match /settings/{visibility} {
        allow read: if resource.data.establishmentId == establishmentId
          && (visibility == 'public'
            || hasRole(establishmentId, ['owner', 'manager']));
        allow create: if hasRole(establishmentId, ['owner', 'manager'])
          && ((visibility == 'public'
              && validPublicSettings(establishmentId, request.resource.data))
            || (visibility == 'private'
              && validPrivateSettings(establishmentId, request.resource.data)));
        allow update: if resource.data.establishmentId == establishmentId
          && hasRole(establishmentId, ['owner', 'manager'])
          && ((visibility == 'public'
              && validPublicSettings(establishmentId, request.resource.data))
            || (visibility == 'private'
              && validPrivateSettings(establishmentId, request.resource.data)));
        allow delete: if false;
      }

      match /auditLogs/{logId} {
        allow get: if resource.data.establishmentId == establishmentId
          && hasRole(establishmentId, ['owner', 'manager']);
        allow list: if hasRole(establishmentId, ['owner', 'manager']);
        allow write: if false;
      }

      match /notificationStates/{stateId} {
        allow read, write: if false;
      }

      match /qrExchanges/{exchangeId} {
        allow read, write: if false;
      }
    }

    match /paymentIntents/{intentId} {
      allow read, write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
